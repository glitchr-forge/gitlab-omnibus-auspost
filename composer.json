{
    "name": "omnibus/auspost",
    "type": "library",
    "description": "Omnibus Australia Post: prices, shipments and labels, tracking - the Shipping and Tracking API.",
    "keywords": [
        "shipping",
        "carrier",
        "omnibus",
        "auspost"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnibus": "^2.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "symfony/http-client": "The HTTP client the carrier talks through"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\Auspost\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\Auspost\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
